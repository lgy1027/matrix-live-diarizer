# Matrix Live Diarizer 配置文件
# 复制此文件为 .env 并修改配置

# ===========================================
# 服务器配置
# ===========================================
HOST=0.0.0.0
PORT=8000
WORKERS=1
DEBUG=false

# ===========================================
# 声纹引擎配置
# ===========================================
# 可选值: campplus, eres2net, wespeaker
SPEAKER_ENGINE=campplus

# ===========================================
# 音频处理配置
# ===========================================
# 采样率 (不要修改)
AUDIO_SAMPLE_RATE=16000

# 缓冲阈值 (采样点数，32000 = 2秒)
AUDIO_BUFFER_THRESHOLD=32000

# 重叠采样点 (4000 = 0.25秒)
AUDIO_OVERLAP_SAMPLES=4000

# 静音检测阈值 (0.0-1.0)
AUDIO_SILENCE_THRESHOLD=0.008

# 无音频超时断开 (秒)
AUDIO_TIMEOUT_SECONDS=30.0

# ===========================================
# VAD 配置
# ===========================================
# VAD 灵敏度 (0.0-1.0，越小越灵敏)
VAD_THRESHOLD=0.5

# 最小语音时长 (毫秒)
VAD_MIN_SPEECH_DURATION=200

# ===========================================
# 音频增益控制
# ===========================================
# 目标音量 RMS
AUDIO_TARGET_RMS=0.08

# 最大增益倍数
AUDIO_MAX_GAIN=10.0

# ===========================================
# 音频队列配置
# ===========================================
# 队列最大容量 (帧数)
AUDIO_QUEUE_SIZE=8

# 触发跳帧的队列阈值
AUDIO_SKIP_FRAME_THRESHOLD=3

# 队列监控间隔 (秒)
AUDIO_QUEUE_MONITOR_INTERVAL=5.0

# ===========================================
# CORS 跨域(部署到 LAN 时收紧)
# ===========================================
# 默认 ['*'] 是因为前端用 file:// 打开,浏览器不发 Origin,等于无限制。
# 部署到 LAN 暴露给其他人时,务必显式列出可信 Origin(逗号分隔)。
ALLOWED_ORIGINS=*                          # [可选, 默认: *]  逗号分隔,例: http://192.168.1.10:8000,http://localhost:8000
# CORS_ALLOW_CREDENTIALS=false              # [可选, 默认: false]  Matrix 不用 cookie 认证,无需开
# CORS_ALLOW_METHODS=*                      # [可选, 默认: *]     允许所有 HTTP 方法
# CORS_ALLOW_HEADERS=*                      # [可选, 默认: *]     允许所有 header

# ===========================================
# 心跳配置
# ===========================================
# 心跳间隔 (秒)
HEARTBEAT_INTERVAL=10

# 心跳超时 (秒)
HEARTBEAT_TIMEOUT=30

# ===========================================
# 缓冲区配置
# ===========================================
# 音频缓冲区上限 (秒)
AUDIO_MAX_BUFFER_SECONDS=10
AUDIO_MAX_SEGMENT_SECONDS=5

# ===========================================
# 文件上传配置
# ===========================================
# 上传音频最大时长 (秒)，默认 1 小时
UPLOAD_MAX_DURATION=3600
# 分段处理时长 (秒)
UPLOAD_CHUNK_DURATION=30
# 分段重叠时长 (秒)
UPLOAD_OVERLAP_DURATION=1.0

# ===========================================
# 存储 / LLM / 历史 (v0.2)
# ===========================================
STORAGE_DB_PATH=./data/matrix.db
STORAGE_HISTORY_ENABLED=true

LLM_ENABLED=false
LLM_ENDPOINT=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:1.5b
LLM_TIMEOUT_SEC=60
LLM_MAX_INPUT_TOKENS=8000
LLM_MOCK=false

HISTORY_RETENTION_DAYS=0
HISTORY_AUTO_ARCHIVE=false

# ===========================================
# ASR 设备配置
# ===========================================
# ASR_DEVICE: auto (默认) | cpu | mps | cuda
#  - cpu: 可靠，慢 (~1x realtime)
#  - mps: 快但 macOS Apple Silicon 偶发死锁（已加 90s 超时回退 cpu）
#  - auto: 优先 mps，90s 超时后自动回退 cpu
# ASR_LOAD_TIMEOUT_SEC: 90
