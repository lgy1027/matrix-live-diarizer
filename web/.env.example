# 前端开发服务器配置
VITE_DEV_SERVER_HOST=127.0.0.1
VITE_DEV_SERVER_PORT=5173

# 后端 FastAPI 地址。开发期 Vite 会把 /v1、/health、/ws 代理到这里。
VITE_BACKEND_URL=http://127.0.0.1:8888

# 可选。默认会从 VITE_BACKEND_URL 自动推导:
# http://127.0.0.1:8000 -> ws://127.0.0.1:8000
# https://example.com -> wss://example.com
# VITE_BACKEND_WS=ws://127.0.0.1:8000
